{"run_id":"repair-main-20261115-crux_eig-4018","seq":3,"ts":1794733733.2119195,"type":"hypothesis.proposed","payload":{"hypothesis":{"id":"family-0","question_id":"signal","statement":"Model 1: Each of the three sources has parameters (x, y, intensity). The predict function computes the sum of Gaussian contributions from each source at each design point. The sample_prior samples source positions uniformly in [-2,2] and intensities uniformly in [0.5,1.5].","author":"proposer","rationale":"Model-generated before observations","answer_key":null,"model_code":"import numpy as np\n\ndef predict(designs, params):\n    n_particles = params.shape[0]\n    n_designs = designs.shape[0]\n    n_sources = 3\n    intensities = params[:, 2::3]  # shape (n_particles, 3)\n    xs = params[:, 0::3]  # shape (n_particles, 3)\n    ys = params[:, 1::3]  # shape (n_particles, 3)\n    # designs shape (n_designs, 2)\n    dx = designs[:, 0][None, None, :] - xs[:, :, None]  # shape (n_particles, 3, n_designs)\n    dy = designs[:, 1][None, None, :] - ys[:, :, None]  # shape (n_particles, 3, n_designs)\n    r2 = dx**2 + dy**2\n    # Gaussian kernel with fixed sigma=0.3\n    sigma = 0.3\n    contributions = intensities[:, :, None] * np.exp(-r2 / (2 * sigma**2))\n    predictions = np.sum(contributions, axis=1)  # sum over sources\n    return predictions\n\ndef sample_prior(rng, n):\n    # sample 3 sources, each (x, y, intensity)\n    xs = rng.uniform(-2, 2, size=(n, 3))\n    ys = rng.uniform(-2, 2, size=(n, 3))\n    intensities = rng.uniform(0.5, 1.5, size=(n, 3))\n    params = np.empty((n, 9))\n    params[:, 0::3] = xs\n    params[:, 1::3] = ys\n    params[:, 2::3] = intensities\n    return params\n","is_null":false,"prior":0.5,"posterior":0.5,"status":"active","rejected_by":[]}}}
{"run_id":"repair-main-20261115-crux_eig-4018","seq":4,"ts":1794733733.2127159,"type":"hypothesis.proposed","payload":{"hypothesis":{"id":"family-1","question_id":"signal","statement":"Model 2: Each source emits an isotropic inverse-distance intensity field with intensity parameter. The predict sums intensity / (distance + epsilon) from each source at design points. The sample_prior samples source positions uniformly in [-2,2] and intensities uniformly in [0.5,1.5].","author":"proposer","rationale":"Model-generated before observations","answer_key":null,"model_code":"import numpy as np\n\ndef predict(designs, params):\n    n_particles = params.shape[0]\n    n_designs = designs.shape[0]\n    n_sources = 3\n    intensities = params[:, 2::3]  # shape (n_particles, 3)\n    xs = params[:, 0::3]\n    ys = params[:, 1::3]\n    dx = designs[:, 0][None, None, :] - xs[:, :, None]\n    dy = designs[:, 1][None, None, :] - ys[:, :, None]\n    dist = np.sqrt(dx**2 + dy**2) + 1e-3  # avoid division by zero\n    contributions = intensities[:, :, None] / dist\n    predictions = np.sum(contributions, axis=1)\n    return predictions\n\ndef sample_prior(rng, n):\n    xs = rng.uniform(-2, 2, size=(n, 3))\n    ys = rng.uniform(-2, 2, size=(n, 3))\n    intensities = rng.uniform(0.5, 1.5, size=(n, 3))\n    params = np.empty((n, 9))\n    params[:, 0::3] = xs\n    params[:, 1::3] = ys\n    params[:, 2::3] = intensities\n    return params\n","is_null":false,"prior":0.5,"posterior":0.5,"status":"active","rejected_by":[]}}}
