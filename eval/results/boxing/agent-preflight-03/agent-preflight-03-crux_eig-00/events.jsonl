{"run_id":"agent-preflight-03-crux_eig-00","seq":3,"ts":1794711440.0104778,"type":"hypothesis.proposed","payload":{"hypothesis":{"id":"family-0","question_id":"signal","statement":"Model 1: Gaussian Mixture Model with three sources. Each source has location (x,y) uniform in [-2,2], and equal amplitude 1. The predict function sums three Gaussian blobs with fixed width (sigma=0.3). The sample_prior samples source locations uniformly.","author":"proposer","rationale":"Model-generated before observations","answer_key":null,"model_code":"import numpy as np\n\ndef predict(designs, params):\n    # params shape: (n_particles, 6) -> 3 sources * 2 coords each\n    n_particles = params.shape[0]\n    n_designs = designs.shape[0]\n    sigma = 0.3\n    designs_exp = designs[np.newaxis, :, :]  # (1, n_designs, 2)\n    params_exp = params[:, np.newaxis, :].reshape(n_particles, 1, 3, 2)  # (n_particles, 1, 3, 2)\n    diff = designs_exp[:, :, np.newaxis, :] - params_exp  # shapes broadcast to (n_particles, n_designs, 3, 2)\n    diff = diff.transpose(0,1,2,3)  # (n_particles, n_designs, 3, 2)\n    dist_sq = np.sum(diff**2, axis=-1)  # (n_particles, n_designs, 3)\n    gaussians = np.exp(-dist_sq/(2*sigma**2))\n    signals = np.sum(gaussians, axis=2)  # sum over sources (n_particles, n_designs)\n    return signals\n\ndef sample_prior(rng, n):\n    # Uniform locations in [-2,2]\n    return rng.uniform(-2, 2, size=(n, 6))  # 3 sources * 2 coordinates each\n","is_null":false,"prior":0.5,"posterior":0.5,"status":"active","rejected_by":[]}}}
{"run_id":"agent-preflight-03-crux_eig-00","seq":4,"ts":1794711440.0104778,"type":"hypothesis.proposed","payload":{"hypothesis":{"id":"family-1","question_id":"signal","statement":"Model 2: Sum of three radial basis functions with exponential decay, each source location uniform in [-2,2]^2, decay rate fixed at 1. The predict sums three exp(-distance) terms.","author":"proposer","rationale":"Model-generated before observations","answer_key":null,"model_code":"import numpy as np\n\ndef predict(designs, params):\n    n_particles = params.shape[0]\n    n_designs = designs.shape[0]\n    designs_exp = designs[np.newaxis, :, :]  # (1, n_designs, 2)\n    params_exp = params[:, np.newaxis, :].reshape(n_particles, 1, 3, 2)  # (n_particles, 1, 3, 2)\n    diff = designs_exp[:, :, np.newaxis, :] - params_exp  # (n_particles, n_designs, 3, 2)\n    dist = np.linalg.norm(diff, axis=-1)  # (n_particles, n_designs, 3)\n    signals = np.sum(np.exp(-dist), axis=2)  # sum over sources (n_particles, n_designs)\n    return signals\n\ndef sample_prior(rng, n):\n    return rng.uniform(-2, 2, size=(n, 6))  # 3 sources * 2 coordinates each\n","is_null":false,"prior":0.5,"posterior":0.5,"status":"active","rejected_by":[]}}}
