{
  "t98g_c10_vs_control_degs": {
    "path": "t98g_c10_vs_control_degs.csv",
    "format": "csv",
    "row_key": "gene_id",
    "kind": "de",
    "required_columns": [
      "gene_id",
      "gene_symbol",
      "base_mean",
      "log2_fold_change",
      "lfc_se",
      "stat",
      "p_value",
      "padj"
    ],
    "checks": [
      {
        "metric": "f1",
        "axis": "rows",
        "scope": {
          "row_filter": "padj < 0.05"
        }
      },
      {
        "metric": "ccc",
        "axis": "columns",
        "scope": {
          "columns": "value_columns",
          "row_filter": "padj < 0.05"
        }
      }
    ],
    "score_combination": "product",
    "value_columns": [
      "log2_fold_change"
    ]
  },
